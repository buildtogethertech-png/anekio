{
  "expo": {
    "name": "Anekio",
    "slug": "anekio",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "anekio",
    "userInterfaceStyle": "light",
    "icon": "./assets/anekio-option-a.png",
    "splash": {
      "backgroundColor": "#f4f7fb",
      "image": "./assets/anekio-option-a.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.anekio.school",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "in.anekio.school",
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/anekio-option-a.png",
          "color": "#1d4ed8",
          "defaultChannel": "notices"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c81e3cb5-d728-4ac2-b626-718b3efc2b53"
      }
    },
    "owner": "buildtogether"
  }
}
