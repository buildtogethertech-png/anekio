{
  "expo": {
    "name": "Anekio",
    "slug": "anekio",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "anekio",
    "userInterfaceStyle": "light",
    "icon": "./assets/anekio-icon-white.png",
    "splash": {
      "backgroundColor": "#0B132B",
      "image": "./assets/anekio-option-a-square.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.anekio.school",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "in.anekio.school",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/anekio-mark-adaptive.png",
        "backgroundColor": "#FFFFFF"
      },
      "versionCode": 19
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/anekio-option-a-square.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/anekio-option-a-square.png",
          "color": "#1d4ed8",
          "defaultChannel": "notices"
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Anekio uses the camera to scan staff attendance QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c81e3cb5-d728-4ac2-b626-718b3efc2b53"
      }
    },
    "owner": "buildtogether",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/c81e3cb5-d728-4ac2-b626-718b3efc2b53",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
