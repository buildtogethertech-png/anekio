NODE_ENV="development"
PORT="4000"
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional Google Sheets onboarding flow. Falls back to GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET when empty.
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_DRIVE_REDIRECT_URI=""
GOOGLE_DRIVE_TOKEN_SECRET=""
# Optional additions; built-in access includes buildtogether.tech@gmail.com and exact anekio.com/anekio.in domains.
ANEKIO_ADMIN_ALLOWED_EMAILS=""
ANEKIO_ADMIN_ALLOWED_DOMAINS=""
# Local development/test only. Defaults to the existing demo password when empty; ignored in production.
ANEKIO_ADMIN_DEV_PASSWORD=""
PUBLIC_URL="http://localhost:4000"
ANEKIO_PUBLIC_URL=""
ANEKIO_ADMIN_URL=""
EXPO_PUBLIC_API_URL="http://localhost:8081"
ANEKIO_API_PROXY_PORT="4000"
# Optional aliases while migrating off Next.js.
NEXTAUTH_SECRET=""
NEXTAUTH_URL=""
APP_JWT_SECRET=""
# Central Anekio authentication email. Keep the API key in Vercel, never in source control.
ANEKIO_AUTH_SECRET=""
ANEKIO_AUTH_RESEND_API_KEY=""
ANEKIO_AUTH_FROM_EMAIL="Anekio <support@anekio.com>"
# Payment keys live in Admin → School (each school uses its own Razorpay / Cashfree / BillDesk).
CRON_SECRET=""
# Vercel provides these automatically in hosted environments.
VERCEL=""
VERCEL_URL=""
VERCEL_PROJECT_PRODUCTION_URL=""
# Uploads default to local disk in development. Use s3 in production/staging after S3 support is configured.
UPLOADS_DRIVER="local"
UPLOADS_DIR="uploads"
AWS_REGION="ap-south-1"
# Hosted Vercel deployments use short-lived OIDC credentials and separate buckets.
AWS_ROLE_ARN=""
AWS_S3_PRIVATE_BUCKET=""
AWS_S3_PUBLIC_BUCKET=""
ANEKIO_SCHOOL_KEY="school"
# Legacy single-bucket fallback while migrating existing deployments.
AWS_S3_BUCKET=""
