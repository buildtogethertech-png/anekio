  total       Int
  paidAmount  Int           @default(0)
  notes       String        @default("")
  issuedAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  payments    SaasPayment[]

  @@index([orgId])
  @@index([status])
  @@index([dueDate])
}

model SaasAuditEvent {
