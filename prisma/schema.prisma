generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Portal {
  OFFICE
  TEACHER
  PARENT
  STUDENT
}

enum AccessScope {
  SELF
  ASSIGNED
  REPORTS
  SCHOOL
}

enum PathTag {
  OLYMPIAD
  SPORTS
  SPELLING
  SCIENCE
  ARTS
}

enum ContestType {
  OLYMPIAD
  SPELLING
  SPORTS
  REGIONAL
  OTHER
}

enum ContestLevel {
  SCHOOL
  DISTRICT
  NATIONAL
  INTERNATIONAL
}

enum PaperType {
  MARK_SHEET
  ANSWER_SHEET
  EVALUATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  HALF_DAY
}

enum PayrollStatus {
  PENDING
  APPROVED
  PAID
}

enum LeaveRequestStatus {
  ACTIVE
  WAITING
  REJECTED
}

enum GrantStatus {
  NOMINATED
  AWARDED
  REJECTED
  IN_PROGRESS
}

enum ApplicationType {
  CONTEST_ENROLL
  LEAVE
  FEE_QUERY
  GRANT_NOMINATION
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InvoiceStatus {
  DUE
  PARTIAL
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  UPI
  RAZORPAY
  CASHFREE
  BILLDESK
  BANK
  CHEQUE
}

enum RoomKind {
  CLASSROOM
  LAB
  GROUND
  OTHER
}

enum StaffKind {
  OFFICE
  LAB
  SUPPORT
  OTHER
}

enum FeeLineKind {
  FLAT
  PERCENT
}

enum ExamWorkflowStatus {
  SCHEDULED
  IN_PROGRESS
  MARKS_DRAFT
  SUBMITTED
  UNDER_REVIEW
  CORRECTION_REQUIRED
  RESUBMITTED
  APPROVED
  PUBLISHED
}

enum SaasEmailEvent {
  DEMO_BOOKED
}

enum SaasEmailAudience {
  INTERNAL
  CUSTOMER
}

enum SaasEmailDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
  BLOCKED
}

model Role {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  portal       Portal
  description  String        @default("")
  isSystem     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  users        User[]
  grants       RoleGrant[]
  staffMembers StaffMember[]
}

model RoleGrant {
  roleId     String
  role       Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission String
  scope      AccessScope?

  @@id([roleId, permission])
}

model User {
  id               String                 @id @default(cuid())
  email            String
  password         String
  name             String
  phone            String?
  pushToken        String?
  roleId           String
  role             Role                   @relation(fields: [roleId], references: [id])
  managerId        String?
  manager          User?                  @relation("ReportsTo", fields: [managerId], references: [id], onDelete: SetNull)
  reports          User[]                 @relation("ReportsTo")
  createdAt        DateTime               @default(now())
  teacher          Teacher?
  parent           Parent?
  student          Student?
  applications     Application[]
  grantsMade       Grant[]                @relation("NominatedBy")
  papers           ExamPaper[]
  attendance       Attendance[]           @relation("MarkedBy")
  staffMember      StaffMember?
  noticesPosted    Notice[]
  noticeRecipients NoticeRecipient[]
  leaveRequests    LeaveRequest[]
  coverAssignments SubstituteAssignment[] @relation("CoverAssignedBy")
  authChallenges   AuthChallenge[]
  googleDrive       GoogleDriveConnection?
  onboardingSheets  OnboardingGoogleSheet[]
  orgId             String?
  org               SaasOrg?                @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@unique([orgId, email])
  @@unique([orgId, phone])
  @@index([orgId])
}

model AuthChallenge {
  id             String    @id
  orgId          String?
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  identifierHash String
  destination    String    @default("")
  purpose        String
  codeHash       String
  attempts       Int       @default(0)
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([identifierHash, purpose, createdAt])
  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

model Teacher {
  id                    String                 @id @default(cuid())
  orgId                 String?
  userId                String                 @unique
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId            String                 @unique
  joinedOn              String                 @default("2026-04-01")
  address               String                 @default("")
  city                  String                 @default("")
  state                 String                 @default("")
  pincode               String                 @default("")
  monthlySalary         Int                    @default(30000)
  qualification         String?
  classId               String?
  class                 Class?                 @relation(fields: [classId], references: [id])
  subjects              Subject[]
  slots                 TimetableSlot[]
  skills                TeacherSkill[]
  classes               TeacherClass[]
  staffDays             StaffDay[]
  leaveRequests         LeaveRequest[]
  substituteAssignments SubstituteAssignment[] @relation("SubstituteTeacher")
  exams                 Exam[]                 @relation("ExamEvaluator")
  setExams              Exam[]                 @relation("ExamSetter")
  examGrants            ExamEvaluator[]
}

model TeacherSkill {
  id          String  @id @default(cuid())
  orgId       String?
  teacherId   String
  teacher     Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectName String
  classId     String
  class       Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectName, classId])
}

model TeacherClass {
  id        String  @id @default(cuid())
  orgId     String?
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classId])
}

model Parent {
  id       String    @id @default(cuid())
  orgId    String?
  userId   String    @unique
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone    String?
  address  String    @default("")
  city     String    @default("")
  state    String    @default("")
  pincode  String    @default("")
  students Student[]
}

model Class {
  id                String             @id @default(cuid())
  orgId             String?
  name              String
  section           String
  archivedAt        DateTime?
  students          Student[]
  teachers          Teacher[]
  subjects          Subject[]
  exams             Exam[]
  examSeries        ExamSeries[]
  invoices          FeeInvoice[]
  feeTemplates      FeeTemplate[]
  admissionFeeLines AdmissionFeeLine[]
  slots             TimetableSlot[]
  teacherLinks      TeacherClass[]
  teacherSkills     TeacherSkill[]
  whatsappGroupUrl  String             @default("")
  noticeLinks       NoticeClass[]

  @@unique([orgId, name, section])
  @@index([orgId])
}

model Student {
  id                  String            @id @default(cuid())
  orgId               String?
  userId              String?           @unique
  user                User?             @relation(fields: [userId], references: [id])
  parentId            String
  parent              Parent            @relation(fields: [parentId], references: [id])
  classId             String
  class               Class             @relation(fields: [classId], references: [id])
  admissionNo         String            @unique
  name                String
  dateOfBirth         DateTime
  interests           StudentInterest[]
  attendance          Attendance[]
  examResults         ExamResult[]
  papers              ExamPaper[]
  contestEntries      ContestEntry[]
  examAudits          ExamResultAudit[]
  grants              Grant[]
  feeInvoices         FeeInvoice[]
  feeAddOns           StudentFeeAddOn[]
  applications        Application[]
  leaveRequests       LeaveRequest[]
  notices             Notice[]
  payToken            String?           @unique
  feeGeneratedThrough String            @default("")
}

model StudentFeeAddOn {
  id           String   @id @default(cuid())
  orgId        String?
  org          SaasOrg? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  label        String
  kind         String   @default("CHARGE")
  amount       Int
  cadence      String   @default("MONTHLY")
  startsPeriod String   @default("")
  endsPeriod   String   @default("")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([studentId, active])
  @@index([startsPeriod, endsPeriod])
  @@index([orgId])
}

model Subject {
  id        String          @id @default(cuid())
  orgId     String?
  name      String
  classId   String
  class     Class           @relation(fields: [classId], references: [id])
  teacherId String?
  teacher   Teacher?        @relation(fields: [teacherId], references: [id])
  weightage Int             @default(0)
  exams     Exam[]
  slots     TimetableSlot[]
}

model StudentInterest {
  id        String  @id @default(cuid())
  orgId     String?
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tag       PathTag

  @@unique([studentId, tag])
}

model Attendance {
  id         String           @id @default(cuid())
  orgId      String?
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date       DateTime
  status     AttendanceStatus
  markedById String?
  markedBy   User?            @relation("MarkedBy", fields: [markedById], references: [id])

  @@unique([studentId, date])
}

model ExamSeries {
  id          String        @id @default(cuid())
  orgId       String?
  classId     String
  class       Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  sessionId   String
  session     SchoolSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  planItemId  String        @default("")
  name        String
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  exams       Exam[]

  @@unique([classId, sessionId, name])
}

model Exam {
  id                 String             @id @default(cuid())
  orgId              String?
  title              String
  subjectId          String
  subject            Subject            @relation(fields: [subjectId], references: [id])
  classId            String
  class              Class              @relation(fields: [classId], references: [id])
  seriesId           String?
  series             ExamSeries?        @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  teacherId          String?
  teacher            Teacher?           @relation("ExamEvaluator", fields: [teacherId], references: [id])
  setterId           String?
  setter             Teacher?           @relation("ExamSetter", fields: [setterId], references: [id])
  date               DateTime
  paperDueOn         DateTime?
  copiesDueOn        DateTime?
  resultOn           DateTime?
  paperFileName      String             @default("")
  paperFilePath      String             @default("")
  paperAt            DateTime?
  marksGrantedAt     DateTime?
  copiesDoneAt       DateTime?
  maxMarks           Int
  workflowStatus     ExamWorkflowStatus @default(SCHEDULED)
  conductedAt        DateTime?
  submittedAt        DateTime?
  reviewedAt         DateTime?
  resultsPublishedAt DateTime?
  correctionNote     String?
  results            ExamResult[]
  papers             ExamPaper[]
  evaluators         ExamEvaluator[]
  markAudits         ExamResultAudit[]

  @@index([paperAt, paperDueOn])
}

model ExamEvaluator {
  examId    String
  orgId     String?
  teacherId String
  grantedAt DateTime @default(now())
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([examId, teacherId])
}

model ExamResult {
  id                      String    @id @default(cuid())
  orgId                   String?
  examId                  String
  exam                    Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId               String
  student                 Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  marks                   Float
  absent                  Boolean   @default(false)
  remarks                 String?
  version                 Int       @default(1)
  correctionNote          String?
  correctionRequestedAt   DateTime?
  correctionRequestedById String?

  @@unique([examId, studentId])
}

model ExamResultAudit {
  id        String   @id @default(cuid())
  orgId     String?
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  marks     Float
  absent    Boolean  @default(false)
  remarks   String?
  action    String
  note      String?
  actorId   String
  createdAt DateTime @default(now())

  @@index([examId, studentId])
}

model ExamPaper {
  id        String    @id @default(cuid())
  orgId     String?
  examId    String
  exam      Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   User      @relation(fields: [teacherId], references: [id])
  type      PaperType
  fileName  String
  filePath  String
  notes     String?
  createdAt DateTime  @default(now())
}

model Contest {
  id           String         @id @default(cuid())
  orgId        String?
  title        String
  type         ContestType
  level        ContestLevel
  startsAt     DateTime
  endsAt       DateTime
  description  String
  entries      ContestEntry[]
  applications Application[]
}

model ContestEntry {
  id        String  @id @default(cuid())
  orgId     String?
  contestId String
  contest   Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  rank      Int?
  score     Float?
  result    String?
  grants    Grant[]

  @@unique([contestId, studentId])
}

model Grant {
  id             String        @id @default(cuid())
  orgId          String?
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  contestEntryId String?
  contestEntry   ContestEntry? @relation(fields: [contestEntryId], references: [id])
  nominatedById  String
  nominatedBy    User          @relation("NominatedBy", fields: [nominatedById], references: [id])
  researchTopic  String
  amount         Int
  status         GrantStatus   @default(NOMINATED)
  notes          String?
  createdAt      DateTime      @default(now())
  applications   Application[]
}

model AdmissionFeeLine {
  id        String   @id @default(cuid())
  orgId     String?
  org       SaasOrg? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  label     String
  amount    Int
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId, active])
  @@index([orgId])
}

model FeeTemplate {
  id            String         @id @default(cuid())
  orgId         String?
  org           SaasOrg?       @relation(fields: [orgId], references: [id], onDelete: SetNull)
  classId       String
  class         Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  sessionId     String?
  session       SchoolSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name          String         @default("Monthly fee")
  startsPeriod  String         @default("")
  endsPeriod    String         @default("")
  dueDay        Int            @default(10)
  lateGraceDays Int            @default(0)
  lateKind      String         @default("")
  lateAmount    Int            @default(0)
  lateAfter10   Int            @default(0)
  lateAfter20   Int            @default(0)
  lines         FeeLine[]
  invoices      FeeInvoice[]

  @@index([classId, sessionId])
  @@index([startsPeriod, endsPeriod])
  @@index([orgId])
}

model FeeLine {
  id         String      @id @default(cuid())
  orgId      String?
  org        SaasOrg?    @relation(fields: [orgId], references: [id], onDelete: SetNull)
  templateId String
  template   FeeTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label      String
  kind       FeeLineKind @default(FLAT)
  amount     Int
  scope      String      @default("ALL")
  sortOrder  Int         @default(0)
  @@index([orgId])
}

model FeeInvoice {
  id               String        @id @default(cuid())
  orgId            String?
  org              SaasOrg?      @relation(fields: [orgId], references: [id], onDelete: SetNull)
  studentId        String
  student          Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId          String?
  class            Class?        @relation(fields: [classId], references: [id])
  templateId       String?
  template         FeeTemplate?  @relation(fields: [templateId], references: [id])
  period           String        @default("")
  kind             String        @default("RECURRING")
  generatedThrough String        @default("")
  title            String
  amount           Int
  linesJson        String        @default("[]")
  dueDate          DateTime
  lateGraceDays    Int           @default(0)
  lateKind         String        @default("")
  lateAmount       Int           @default(0)
  lateFeePerDay    Int           @default(0)
  lateAfter10      Int           @default(0)
  lateAfter20      Int           @default(0)
  shareToken       String?       @unique
  status           InvoiceStatus @default(DUE)
  payments         Payment[]
  reminders        FeeReminder[]

  @@unique([studentId, period])
  @@index([orgId])
}

model SchoolOnboardingState {
  id                  String                   @id
  selectedModulesJson String                   @default("[\"students\",\"fees\"]")
  startedAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  imports             SchoolOnboardingImport[]
  googleSheets        OnboardingGoogleSheet[]
  orgId              String?
  org                SaasOrg?                 @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@index([orgId])
}

model SchoolOnboardingImport {
  id           String                @id @default(cuid())
  orgId        String?
  stateId      String                @default("school")
  state        SchoolOnboardingState @relation(fields: [stateId], references: [id], onDelete: Cascade)
  kind         String
  fileName     String
  uploadPath   String
  status       String                @default("REVIEW")
  rowsJson     String                @default("[]")
  errorsJson   String                @default("[]")
  createdCount Int                   @default(0)
  updatedCount Int                   @default(0)
  createdAt    DateTime              @default(now())
  appliedAt    DateTime?

  @@index([stateId, kind, createdAt])
}

model GoogleDriveConnection {
  id                    String   @id @default(cuid())
  orgId                 String?
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleEmail           String   @default("")
  scope                 String   @default("")
  encryptedAccessToken  String   @default("")
  encryptedRefreshToken String   @default("")
  expiresAt             DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([googleEmail])
}

model OnboardingGoogleSheet {
  id          String                @id @default(cuid())
  orgId       String?
  stateId     String                @default("school")
  state       SchoolOnboardingState @relation(fields: [stateId], references: [id], onDelete: Cascade)
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String
  fileId      String                @unique
  name        String
  webViewLink String
  createdAt   DateTime              @default(now())
  reviewedAt  DateTime?
  importId    String?

  @@index([stateId, kind, createdAt])
  @@index([userId, createdAt])
}

model Payment {
  id        String        @id @default(cuid())
  orgId     String?
  org       SaasOrg?      @relation(fields: [orgId], references: [id], onDelete: SetNull)
  invoiceId String
  invoice   FeeInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Int
  method    PaymentMethod @default(CASH)
  reference String?
  proofPath String?
  notes     String?
  paidAt    DateTime      @default(now())
  @@index([orgId])
}

model FeeReminder {
  id        String     @id @default(cuid())
  orgId     String?
  org       SaasOrg?   @relation(fields: [orgId], references: [id], onDelete: SetNull)
  invoiceId String
  invoice   FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sentAt    DateTime   @default(now())
  message   String
  @@index([orgId])
}

model Application {
  id          String            @id @default(cuid())
  orgId       String?
  type        ApplicationType
  status      ApplicationStatus @default(PENDING)
  requesterId String
  requester   User              @relation(fields: [requesterId], references: [id])
  studentId   String?
  student     Student?          @relation(fields: [studentId], references: [id])
  contestId   String?
  contest     Contest?          @relation(fields: [contestId], references: [id])
  grantId     String?
  grant       Grant?            @relation(fields: [grantId], references: [id])
  title       String
  body        String
  createdAt   DateTime          @default(now())
}

model SchoolConfig {
  id                    String                    @id @default(cuid())
  orgId                 String?                   @unique
  org                   SaasOrg?                  @relation(fields: [orgId], references: [id], onDelete: SetNull)
  weekdays              String                    @default("[1,2,3,4,5,6]")
  name                  String                    @default("Anekio School")
  address               String                    @default("")
  city                  String                    @default("")
  state                 String                    @default("")
  pincode               String                    @default("")
  phone                 String                    @default("")
  email                 String                    @default("")
  affiliation           String                    @default("")
  gstin                 String                    @default("")
  pan                   String                    @default("")
  upiId                 String                    @default("")
  bankName              String                    @default("")
  bankAccountName       String                    @default("")
  bankAccountNumber     String                    @default("")
  bankIfsc              String                    @default("")
  payGateway            String                    @default("NONE")
  payTestMode           Boolean                   @default(true)
  razorpayKeyId         String                    @default("")
  razorpayKeySecret     String                    @default("")
  razorpayWebhookSecret String                    @default("")
  cashfreeAppId         String                    @default("")
  cashfreeSecretKey     String                    @default("")
  billdeskMerchantId    String                    @default("")
  billdeskClientId      String                    @default("")
  billdeskSecret        String                    @default("")
  aisensyApiKey         String                    @default("")
  aisensyCampaign       String                    @default("fee_reminder")
  resendApiKey          String                    @default("")
  resendFromEmail       String                    @default("")
  signatory             String                    @default("")
  logoPath              String                    @default("")
  signPath              String                    @default("")
  stampPath             String                    @default("")
  invoiceStyle          String                    @default("classic")
  websiteEnabled        Boolean                   @default(false)
  websiteSlug           String?                   @unique
  websiteTheme          String                    @default("blue")
  websiteHeroTitle      String                    @default("")
  websiteHeroSubtitle   String                    @default("")
  websiteAbout          String                    @default("")
  websiteHighlights     String                    @default("[\"CBSE aligned learning\",\"Safe campus\",\"Smart parent updates\",\"Admissions open\"]")
  websiteFacilities     String                    @default("[\"Digital classrooms\",\"Library\",\"Computer lab\",\"Sports\",\"Transport\"]")
  websiteGallery        String                    @default("[]")
  websiteAdmissionOpen  Boolean                   @default(true)
  websiteAdmissionNote  String                    @default("Admissions are open. Submit an enquiry and our office will contact you.")
  admissionFormJson     String                    @default("[]")
  admissionCharge       Int                       @default(0)
  sessionStart          String                    @default("")
  sessionEnd            String                    @default("")
  gradeBandsJson        String                    @default("[{\"min\":91,\"grade\":\"A1\"},{\"min\":81,\"grade\":\"A2\"},{\"min\":71,\"grade\":\"B1\"},{\"min\":61,\"grade\":\"B2\"},{\"min\":51,\"grade\":\"C1\"},{\"min\":41,\"grade\":\"C2\"},{\"min\":33,\"grade\":\"D\"},{\"min\":0,\"grade\":\"E\"}]")
  passPercent           Int                       @default(33)
  showRank              Boolean                   @default(false)
  reportCardPaidMonths  Int                       @default(0)
  whatsappCommunityUrl  String                    @default("")
  subjectCatalog        String                    @default("[\"English\",\"Mathematics\",\"Hindi\",\"Science\",\"Social Science\",\"Computer\"]")
