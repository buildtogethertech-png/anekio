}

model AdmissionLeadEvent {
  id        String        @id @default(cuid())
  orgId     String?
  leadId    String
  kind      String
  title     String
  body      String        @default("")
  actorName String        @default("")
  createdAt DateTime      @default(now())
  lead      AdmissionLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
