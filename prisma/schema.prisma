model SaasOrg {
  id                 String               @id @default(cuid())
  schoolName         String
  ownerName          String
  ownerEmail         String
  ownerCountryCode   String               @default("+91")
  ownerPhone         String
  city               String               @default("")
  teacherCount       Int?
  studentCount       Int?
  plan               String               @default("Monthly school")
  monthlyPrice       Int                  @default(1000)
  paymentStatus      String               @default("PENDING")
  subscriptionStatus String               @default("LEAD")
  source             String               @default("MANUAL")
  pipelineStage      String               @default("NEW")
  lifecycle          String               @default("LEAD")
  interestedIn       String               @default("")
  onboardingStatus   String               @default("NOT_STARTED")
  customerSince      DateTime?
  loginUrl           String               @default("")
  apiUrl             String               @default("")
  notes              String               @default("")
  followUpStatus     String               @default("NEW")
  assignedOwner      String               @default("")
  nextFollowUpOn     DateTime?
  billingAddress     String               @default("")
  billingState       String               @default("")
  billingPincode     String               @default("")
  gstin              String               @default("")
  subscriptionStart  DateTime?
  renewalOn          DateTime?
  razorpayCustomerId String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  payments           SaasPayment[]
  invoices           SaasInvoice[]
  auditEvents        SaasAuditEvent[]
  subscriptions      SaasSubscription[]
  demos              SaasDemo[]
  followUps          SaasFollowUp[]
  onboardingTasks    SaasOnboardingTask[]
  supportTickets     SaasSupportTicket[]
  emailDeliveries    SaasEmailDelivery[]
  users              User[]
  schoolConfigs      SchoolConfig[]
  onboardingStates   SchoolOnboardingState[]
  studentFeeAddOns   StudentFeeAddOn[]
  admissionFeeLines  AdmissionFeeLine[]
  feeTemplates       FeeTemplate[]
  feeLines           FeeLine[]
  feeInvoices        FeeInvoice[]
  feePayments        Payment[]
  feeReminders       FeeReminder[]

  @@index([ownerEmail])
  @@index([ownerPhone])
  @@index([subscriptionStatus])
  @@index([pipelineStage])
  @@index([lifecycle])
}

model SaasSubscription {
  id            String    @id @default(cuid())
  orgId         String
