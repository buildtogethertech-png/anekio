  subject   String
  body      String   @default("")
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([status])
}

model SaasPayment {
  id        String       @id @default(cuid())
  orgId     String
  org       SaasOrg      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoiceId String?
  invoice   SaasInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  amount    Int
  currency  String       @default("INR")
  provider  String       @default("RAZORPAY")
  orderId   String?
  paymentId String?
  status    String       @default("CREATED")
  notes     String       @default("")
  createdAt DateTime     @default(now())
  paidAt    DateTime?

  @@index([orgId])
  @@index([invoiceId])
  @@index([orderId])
  @@index([paymentId])
}

model SaasInvoice {
  id          String        @id @default(cuid())
  orgId       String
