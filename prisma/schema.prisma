model DocumentTemplate {
  id            String                    @id @default(cuid())
  orgId         String?
  schoolId      String                    @default("school")
  school        SchoolConfig              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  type          String
  category      String
  name          String
  description   String                    @default("")
  pageSize      String                    @default("A4")
  orientation   String                    @default("PORTRAIT")
  scopeJson     String                    @default("{}")
  draftJson     String                    @default("{\"elements\":[]}")
  status        String                    @default("DRAFT")
  activeVersion Int?
  createdById   String
  updatedById   String
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  versions      DocumentTemplateVersion[]

  @@index([schoolId, type, status])
  @@index([schoolId, category])
  @@index([schoolId, updatedAt])
}

model DocumentTemplateVersion {
  id              String           @id @default(cuid())
  orgId           String?
  schoolId        String           @default("school")
  school          SchoolConfig     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  templateId      String
  template        DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version         Int
  layoutJson      String
  pageSize        String
  orientation     String
  scopeJson       String           @default("{}")
  publishedById   String
  publishedAt     DateTime         @default(now())
  issuedDocuments IssuedDocument[]

  @@unique([templateId, version])
  @@index([schoolId, templateId, publishedAt])
  @@index([templateId, publishedAt])
}

model IssuedDocument {
  id                String                  @id @default(cuid())
  orgId             String?
  schoolId          String                  @default("school")
  school            SchoolConfig            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  documentNumber    String
  verifyToken       String                  @unique
  templateVersionId String
  templateVersion   DocumentTemplateVersion @relation(fields: [templateVersionId], references: [id])
  type              String
  subjectType       String
  subjectId         String
  subjectLabel      String                  @default("")
  status            String                  @default("VALID")
  dataJson          String                  @default("{}")
  renderedHtml      String                  @default("")
  fileHash          String                  @default("")
  issuedById        String
  issuedAt          DateTime                @default(now())
  batchId           String?
  expiresAt         DateTime?
  supersedesId      String?
  statusReason      String                  @default("")
  events            DocumentEvent[]

  @@unique([schoolId, documentNumber])
  @@index([schoolId, type, issuedAt])
  @@index([schoolId, issuedAt])
  @@index([schoolId, subjectType, subjectId])
  @@index([batchId])
  @@index([status])
}

model DocumentEvent {
  id               String         @id @default(cuid())
  orgId            String?
  issuedDocumentId String
  issuedDocument   IssuedDocument @relation(fields: [issuedDocumentId], references: [id], onDelete: Cascade)
  action           String
  actorId          String
  reason           String         @default("")
  metadataJson     String         @default("{}")
  createdAt        DateTime       @default(now())

  @@index([issuedDocumentId, createdAt])
  @@index([action, createdAt])
}

model Notice {
  id         String            @id @default(cuid())
  orgId      String?
  eventKey   String?           @unique
  title      String
  body       String
  kind       String            @default("CIRCULAR")
  priority   String            @default("INFO")
  authorId   String
  author     User              @relation(fields: [authorId], references: [id])
  studentId  String?
  student    Student?          @relation(fields: [studentId], references: [id], onDelete: SetNull)
  createdAt  DateTime          @default(now())
  audiences  NoticeAudience[]
  classes    NoticeClass[]
  recipients NoticeRecipient[]
}

model NoticeRecipient {
  noticeId String
  orgId    String?
  notice   Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([noticeId, userId])
  @@index([userId])
}

model NoticeAudience {
  noticeId String
  orgId    String?
  notice   Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  portal   Portal

  @@id([noticeId, portal])
}

model NoticeClass {
  noticeId String
  orgId    String?
  notice   Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  classId  String
  class    Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([noticeId, classId])
}

model LeaveType {
  id                String         @id @default(cuid())
  orgId             String?
  name              String
  forTeacher        Boolean        @default(true)
  forStaff          Boolean        @default(true)
  forStudent        Boolean        @default(true)
