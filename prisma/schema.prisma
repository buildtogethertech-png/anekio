  status      String   @default("SCHEDULED")
  assignedTo  String   @default("")
  notes       String   @default("")
  createdAt   DateTime @default(now())

  @@index([orgId])
  @@index([scheduledAt])
}

model SaasFollowUp {
  id         String    @id @default(cuid())
