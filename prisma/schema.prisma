  actorEmail String
  action     String
  detail     String   @default("")
  entityType String   @default("")
  entityId   String   @default("")
  createdAt  DateTime @default(now())

  @@index([orgId])
  @@index([createdAt])
}

model SaasSitePricing {
  id            String   @id @default("anekio")
  planName      String   @default("Launch")
  listPrice     Int      @default(29999)
  discountOn    Boolean  @default(true)
  discountType  String   @default("AMOUNT")
  discountValue Int      @default(15000)
  offerLabel    String   @default("Early bird")
  billingPeriod String   @default("year")
  trialDays     Int      @default(7)
  updatedAt     DateTime @updatedAt
}

model SaasEmailConfig {
  id                    String          @id @default("anekio")
  enabled               Boolean         @default(false)
  resendApiKey          String          @default("")
  productionFromName    String          @default("Anekio Support")
  productionFromEmail   String          @default("support@anekio.com")
  stagingFromName       String          @default("Anekio Staging")
  stagingFromEmail      String          @default("support@mail.staging.anekio.com")
  stagingSafeRecipients String          @default("[\"support@anekio.com\"]")
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  rules                 SaasEmailRule[]
}

model SaasEmailRule {
  id              String              @id @default(cuid())
  configId        String              @default("anekio")
  config          SaasEmailConfig     @relation(fields: [configId], references: [id], onDelete: Cascade)
  event           SaasEmailEvent
  audience        SaasEmailAudience
  enabled         Boolean             @default(true)
  sortOrder       Int                 @default(0)
  toRecipients    String              @default("[]")
  ccRecipients    String              @default("[]")
  bccRecipients   String              @default("[]")
  replyTo         String              @default("[]")
  subjectTemplate String              @default("")
  textTemplate    String              @default("")
  htmlTemplate    String              @default("")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deliveries      SaasEmailDelivery[]

  @@unique([configId, event, audience])
  @@index([event, audience])
}

model SaasEmailDelivery {
  id              String                  @id @default(cuid())
  orgId           String
  org             SaasOrg                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ruleId          String?
  rule            SaasEmailRule?          @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  event           SaasEmailEvent
  audience        SaasEmailAudience
  environment     String                  @default("staging")
  idempotencyKey  String
  status          SaasEmailDeliveryStatus @default(PENDING)
  fromEmail       String                  @default("")
  toRecipients    String                  @default("[]")
  ccRecipients    String                  @default("[]")
  bccRecipients   String                  @default("[]")
  replyTo         String                  @default("[]")
  subject         String                  @default("")
  resendMessageId String                  @default("")
  errorMessage    String                  @default("")
  attemptCount    Int                     @default(0)
  attemptedAt     DateTime?
  sentAt          DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([event, idempotencyKey, audience])
  @@index([orgId, createdAt])
  @@index([status, createdAt])
}
