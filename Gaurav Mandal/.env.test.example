# Copy to .env.test for local tooling. Keep .env.test untracked.
TEST_ENV="local"
NODE_ENV="test"

# Tests map this value to DATABASE_URL. Never point it at prisma/dev.db,
# prisma/demo.db, a staging database, or a production database.
TEST_DATABASE_URL="file:./test-results/playwright/test-e2e.db"

# Generate a fresh value per run/CI job; do not commit the generated value.
TEST_JWT_SECRET=""

# Playwright uses isolated ports so it can run beside the development servers.
BASE_URL="http://127.0.0.1:8082"
API_URL="http://127.0.0.1:4100"
PLAYWRIGHT_BASE_URL="http://127.0.0.1:8082"
PLAYWRIGHT_API_PORT="4100"
PLAYWRIGHT_SKIP_WEBSERVER="0"
PLAYWRIGHT_API_COMMAND="tsx tests/support/start-e2e-server.ts"
PLAYWRIGHT_WEB_COMMAND="npm --prefix mobile run web -- --port 8082"

# Seeded fixture identities are non-secret; passwords must come from the local
# test seed or the CI secret store and must never be real user credentials.
ANEKIO_OFFICE_LOGIN="office.fixture@school.test"
ANEKIO_OFFICE_PASSWORD=""
ANEKIO_TEACHER_LOGIN="teacher.fixture@school.test"
ANEKIO_TEACHER_PASSWORD=""
ANEKIO_PARENT_LOGIN="parent.fixture@school.test"
ANEKIO_PARENT_PASSWORD=""
ANEKIO_STUDENT_LOGIN="student.fixture@school.test"
ANEKIO_STUDENT_PASSWORD=""

# Maestro requires a booted simulator/emulator and an already installed,
# release-shaped artifact (preview APK or simulator .app), never Expo Go.
MAESTRO_APP_ID="in.anekio.school"
MAESTRO_ANDROID_APP_PATH=""
MAESTRO_IOS_APP_PATH=""
MAESTRO_DRIVER_STARTUP_TIMEOUT="120000"
