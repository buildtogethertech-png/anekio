{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": { "@/*": ["./*"] }
  },
  "include": ["lib/**/*.ts", "server/**/*.ts", "api/**/*.ts", "prisma/**/*.ts"],
  "exclude": ["node_modules", "mobile"]
}
