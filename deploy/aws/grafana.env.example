# Copy to deploy/aws/.grafana.env (git-ignored) and fill from Grafana Cloud:
#   grafana.com → My Account → your stack → Prometheus "Details" and Loki "Details" (URLs + user numbers),
#   and an Access Policy token with metrics:write + logs:write.
GRAFANA_PROM_URL="https://prometheus-prod-XX-prod-ap-south-X.grafana.net/api/prom/push"
GRAFANA_PROM_USER="1234567"
GRAFANA_LOKI_URL="https://logs-prod-XXX.grafana.net/loki/api/v1/push"
GRAFANA_LOKI_USER="7654321"
GRAFANA_TOKEN="glc_..."
# Read-only RDS login for the Postgres dashboard (deploy/db/monitor-user.sql).
MONITOR_DB_URL="postgresql://anekio_monitor:PASSWORD@anekio-prod-db.xxxx.ap-south-1.rds.amazonaws.com:5432/anekio?sslmode=require"
# Where https://monitoring.anekio.com should send people (your stack URL).
GRAFANA_STACK_URL="https://yourstack.grafana.net"
