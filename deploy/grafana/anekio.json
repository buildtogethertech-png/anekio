      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "max((1 - node_memory_MemAvailable_bytes{instance=\"anekio-prod\"} / node_memory_MemTotal_bytes{instance=\"anekio-prod\"}) * 100)",
          "instant": true,
          "range": false
