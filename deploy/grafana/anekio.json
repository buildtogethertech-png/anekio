      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({job=\"anekio-nginx\"} | json status=\"status\" | status >= 500 [$__range])) or vector(0)",
